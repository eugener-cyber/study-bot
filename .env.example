# Образец. Реальные значения — только в локальном .env, он в .gitignore.
# ТЗ §30.2. Как получить — см. Инструкция_Telegram.

# @BotFather -> /newbot
BOT_TOKEN=

# my.telegram.org -> API development tools. Нужны контейнеру telegram-bot-api (§2.2),
# не самому боту. Выдаются по номеру телефона владельца аккаунта.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Белый список (§1.3). Числовые id через запятую: @userinfobot -> /start.
# Персональные данные: реальные значения сюда не вписывать.
ALLOWED_USER_IDS=

DATABASE_URL=postgresql+asyncpg://studybot:studybot@127.0.0.1:5432/studybot
REDIS_URL=redis://redis:6379/0
TZ_DEFAULT=Europe/Moscow

# §2.1: anthropic | yandexgpt | manual
LLM_PROVIDER=manual
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
COST_CURRENCY=USD

WHISPER_MODEL=
WHISPER_DEVICE=cpu
