# Заведомо нерабочие значения для CI. Настоящих секретов здесь нет и быть не должно.
# ТЗ §30.2. Как получить — см. Инструкция_Telegram.

# @BotFather -> /newbot
BOT_TOKEN=0000000000:CI-NOT-A-REAL-TOKEN-0000000000000

# my.telegram.org -> API development tools. Нужны контейнеру telegram-bot-api (§2.2),
# не самому боту. Выдаются по номеру телефона владельца аккаунта.
TELEGRAM_API_ID=1
TELEGRAM_API_HASH=00000000000000000000000000000000

# Белый список (§1.3). Числовые id через запятую: @userinfobot -> /start.
# Персональные данные: реальные значения сюда не вписывать.
ALLOWED_USER_IDS=1,2

DATABASE_URL=postgresql+asyncpg://ci:ci@localhost:5432/ci
REDIS_URL=redis://localhost:6379/0
TZ_DEFAULT=Europe/Moscow

# §2.1: anthropic | yandexgpt | manual
LLM_PROVIDER=manual
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
COST_CURRENCY=USD

WHISPER_MODEL=
WHISPER_DEVICE=cpu
